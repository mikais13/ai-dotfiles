{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/plannotator",
            "timeout": 345600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook codex"
          },
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/block-env-files.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.agents/hooks/block-recursive-grep.sh"
          }
        ]
      }
    ]
  }
}
